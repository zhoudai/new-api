# 复制到服务器 /data/ai-platform/production.env，设置权限 600；不要把实际值提交到仓库。
# AI_PLATFORM_RELEASE 填写 New API 镜像版本；AI_BRIDGE_RELEASE 填写独立 Bridge 镜像版本。
AI_PLATFORM_RELEASE=
AI_BRIDGE_RELEASE=

POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=

# P07 核实 Nginx 到容器的实际来源地址后填写，不要使用宽泛网段。
TRUSTED_PROXIES=

# P08 平台首次初始化后创建 HZC 商家和项目凭证再填写；Bridge 通过在线校验接口检查项目凭证。
AI_BRIDGE_PROJECT_ID=
# 每行一个 enterprise_id=New API 内部 Key；只存受控服务器配置，不写 Git 或聊天。
AI_BRIDGE_ENTERPRISE_TOKENS=
