# edu-training 独立 bridge 配置模板；真实值放入同目录 .env.edu-training.local，不提交 Git。
EDU_TRAINING_BRIDGE_PROJECT_ID=edu-training
EDU_TRAINING_BRIDGE_PROJECT_KEY=replace-with-edu-training-project-credential
# 托管凭证启用后每次请求在线校验，PROJECT_KEY 不再参与鉴权。
EDU_TRAINING_BRIDGE_CREDENTIAL_VERIFY_URL=http://new-api:3000/api/project-credentials/verify
# 每行一个学校映射，换行就是分隔符：学校企业标识=学校专用内部 New API Key
EDU_TRAINING_BRIDGE_ENTERPRISE_TOKENS="school-001=replace-with-school-001-internal-key
school-002=replace-with-school-002-internal-key"
