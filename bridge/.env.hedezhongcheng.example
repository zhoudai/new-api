# 所属项目：hedezhongcheng
# 仅供本地配置参考；真实值请通过部署平台 Secret 注入，不要提交 .env.local。
AI_BRIDGE_PROJECT_ID=hedezhongcheng
AI_BRIDGE_PROJECT_KEY=replace-with-project-credential
# 托管凭证启用后每次请求在线校验，PROJECT_KEY 不再参与鉴权；仅使用受信任平台地址。
AI_BRIDGE_CREDENTIAL_VERIFY_URL=http://new-api:3000/api/project-credentials/verify
AI_BRIDGE_ENTERPRISE_TOKENS=platform-ops=replace-with-new-api-key
